<Window x:Class="FF34Manip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FF34Manip"
        mc:Ignorable="d"
        Title="FF34Manip" Width="200"
        SizeToContent="Height" MinHeight="700"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}">
    
    <!--Tab background colour styling-->
    <Window.Resources>
        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=tabControl, Path=SelectedIndex}" Value="0">
                    <Setter Property="Background" Value="#cdfada" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=tabControl, Path=SelectedIndex}" Value="1">
                    <Setter Property="Background" Value="#cdcefa" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <DataTemplate x:Key="ManipButtonTemplate">
            <Button Width="150" Margin="0,5,0,0" Content="{Binding Name}" Click="StartManip"/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" HorizontalAlignment="Center">
            <Grid.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Margin" Value="0,5,0,0"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dock panel for Offset settings -->
            <DockPanel Grid.Row="0" HorizontalAlignment="Left">
                <Label Content="Offset (seconds):"/>
                <TextBox x:Name="integerTextBox" Width="25" Margin="10 0 0 0"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         PreviewTextInput="Offset_PreviewTextInput"
                         PreviewKeyDown="Offset_PreviewKeyDown"
                         Text=""/>
            </DockPanel>

            <TextBlock Grid.Row="1" x:Name="manipStatus" Height="18" Margin="0,2,0,0"
                       TextAlignment="Center" FontWeight="Bold" Foreground="#b00000" Text=""/>

            <TabControl Grid.Row="2" x:Name="tabControl" TabStripPlacement="Top" HorizontalContentAlignment="Stretch" Style="{StaticResource TabControlStyle}">
                <TabItem Header="FF3" Width="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Manips.FF3, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}"
                                      ItemTemplate="{StaticResource ManipButtonTemplate}"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="FF4" Width="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Manips.FF4, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}"
                                      ItemTemplate="{StaticResource ManipButtonTemplate}"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <Label Grid.Row="1" Content="{Binding AppVersion, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" HorizontalAlignment="Right" VerticalAlignment="Bottom"></Label>
    </Grid>
</Window>